<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标前景层：LeapCo 的 "L"
  - 自适应图标画布 108×108；内容收在 24~87，落在不会被裁切的安全区内
  - 单笔折线 + 圆头端点：小尺寸下依然是一笔可辨的 L
    （旧图标有车身、车窗、车轮、数据波形，缩到 48dp 全糊成噪点）
  - 右上薄荷点：数据点的落点，也是 "Leap" 的暗示
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="M38,30 L38,76 L80,76"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <path
        android:fillColor="#7BD1EE"
        android:pathData="M70,40 m-6.5,0 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0" />
</vector>
